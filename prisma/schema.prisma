datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  displayName  String
  email     String   @unique
  passwordHash String
  createdAt DateTime @default(now())

  reviews Review[]
  sessions Session[]
}

model Session {
  id           Int      @id @default(autoincrement())
  token        String   @unique
  userId       Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id             Int      @id @default(autoincrement())
  authorId       Int
  comment        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}
