<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
{{> header}}

<main>
  <section>
    <h2>Отзывы</h2>
    <p class="small-muted">Отзывы теперь сохраняются в базе данных, а новые сообщения появляются у всех посетителей страницы почти сразу.</p>

    {{#if canLeaveReview}}
      <form id="feedbackForm" class="form-card" method="post" action="/reviews" novalidate>
        <div class="form-row">
          <label for="fbText"><strong>Ваш отзыв</strong></label>
          <textarea id="fbText" name="comment" required minlength="10" maxlength="300" rows="5" placeholder="Поделитесь впечатлением о кофе, атмосфере или сервисе."></textarea>
          <p class="field-hint">От 10 до 300 символов. Переносы строк сохраняются.</p>
          <div class="md-preview" id="mdPreview" aria-live="polite">Здесь появится предварительный просмотр текста.</div>
        </div>

        <button type="submit" class="btn">Опубликовать отзыв</button>
      </form>
    {{else}}
      <div class="form-card">
        <p>Чтобы оставить отзыв, войдите в аккаунт или создайте новый.</p>
        <p>
          <a href="{{session.loginUrl}}">Войти</a>
          /
          <a href="{{session.registerUrl}}">Зарегистрироваться</a>
        </p>
      </div>
    {{/if}}
  </section>

  <section>
    <div class="section-head">
      <h2>Лента отзывов</h2>
      <div id="reviewStatus" class="small-muted" aria-live="polite"></div>
    </div>

    <div
      id="feedbackList"
      class="list"
      data-user-id="{{session.userId}}"
    >
      {{#each reviews}}
        {{> review_item}}
      {{/each}}
    </div>

    <p id="reviewsEmptyState" class="empty-state {{#if reviews.length}}is-hidden{{/if}}">
      Пока отзывов нет. Станьте первым гостем, который поделится впечатлениями.
    </p>

    <template id="reviewTemplate">
      <article class="item review-item" data-review-id="" data-author-id="">
        <div class="item-head">
          <div>
            <div class="item-title js-review-author"></div>
            <div class="item-sub js-review-email"></div>
            <div class="item-meta">
              <span class="js-review-created"></span>
              <span class="js-review-updated is-hidden"></span>
            </div>
          </div>

          <div class="item-actions is-hidden">
            <button type="button" class="btn btn-small js-edit">Редактировать</button>
            <button type="button" class="btn btn-small btn-danger js-delete">Удалить</button>
          </div>
        </div>

        <p class="item-text js-review-text"></p>

        <form class="edit-form is-hidden" novalidate>
          <label>
            <span class="sr-only">Новый текст отзыва</span>
            <textarea class="edit-text" required minlength="10" maxlength="300" rows="4"></textarea>
          </label>
          <div class="edit-actions">
            <button type="submit" class="btn btn-small">Сохранить</button>
            <button type="button" class="btn btn-small js-cancel">Отмена</button>
          </div>
          <p class="edit-error" aria-live="polite"></p>
        </form>
      </article>
    </template>
  </section>
</main>

<div id="toastContainer" class="toast-stack" aria-live="polite" aria-atomic="true"></div>

{{> footer}}
</body>
</html>
