<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
{{> header}}

<main>
  <section id="price-table" aria-labelledby="price-title">
    <h2 id="price-title">Прайс на напитки (₽)</h2>

    <div class="table-scroll" role="region" aria-label="Таблица цен (горизонтальная прокрутка)">
      <table class="table-grid">
        <thead>
          <tr>
            <th scope="col">Позиция</th>
            <th scope="col">250 мл</th>
            <th scope="col">350 мл</th>
            <th scope="col">450 мл</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Капучино</th>
            <td class="num">200</td>
            <td class="num">230</td>
            <td class="num">260</td>
          </tr>
          <tr>
            <th scope="row">Латте</th>
            <td class="num">220</td>
            <td class="num">250</td>
            <td class="num">280</td>
          </tr>
          <tr>
            <th scope="row">Эспрессо</th>
            <td class="num">150</td>
            <td class="num">—</td>
            <td class="num">—</td>
          </tr>
          <tr>
            <th scope="row">Айс-латте</th>
            <td class="num">230</td>
            <td class="num">260</td>
            <td class="num">290</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</main>

{{> footer}}
</body>
</html>
