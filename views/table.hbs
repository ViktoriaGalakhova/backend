<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
{{> header}}

<main>
  <section id="price-table" aria-labelledby="price-title">
    <h2 id="price-title">Прайс на напитки (₽)</h2>

    <div class="table-scroll" role="region" aria-label="Таблица цен">
      <table class="table-grid">
        <thead>
          <tr>
            <th scope="col">Позиция</th>
            <th scope="col">250 мл</th>
            <th scope="col">350 мл</th>
            <th scope="col">450 мл</th>
          </tr>
        </thead>
        <tbody>
          {{#each priceRows}}
            <tr>
              <th scope="row">{{name}}</th>
              <td class="num">{{prices.[0]}}</td>
              <td class="num">{{prices.[1]}}</td>
              <td class="num">{{prices.[2]}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
</main>

{{> footer}}
</body>
</html>
